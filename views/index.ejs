<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SecureBank - Modern Banking</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar">
        <div class="nav-brand">
            <h1>🏦 SecureBank</h1>
        </div>
        <ul class="nav-links">
            <li><a href="/">Home</a></li>
            <li><a href="/login">Login</a></li>
            <li><a href="/register">Register</a></li>
        </ul>
    </nav>

    <div class="hero">
        <h1>Welcome to SecureBank</h1>
        <p>Your trusted partner in modern banking solutions</p>
        <div class="hero-buttons">
            <a href="/register" class="btn btn-primary">Open Account</a>
            <a href="/login" class="btn btn-secondary">Login</a>
        </div>
    </div>

    <section class="features">
        <h2>Our Services</h2>
        <div class="feature-grid">
            <div class="feature-card">
                <div class="feature-icon">💳</div>
                <h3>Debit & Credit Cards</h3>
                <p>Request and manage your cards with ease</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">💸</div>
                <h3>Money Transfer</h3>
                <p>Instant transfers to any account</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">📊</div>
                <h3>Transaction History</h3>
                <p>Track all your transactions in real-time</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">🏠</div>
                <h3>Loans</h3>
                <p>Personal, Home, and Auto loans at competitive rates</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">👤</div>
                <h3>Profile Management</h3>
                <p>Update your information securely</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">🔒</div>
                <h3>Secure Banking</h3>
                <p>Bank-grade security for your peace of mind</p>
            </div>
        </div>
    </section>

    <footer>
        <p>&copy; 2024 SecureBank. All rights reserved.</p>
    </footer>
</body>
</html>
