<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - SecureBank</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar">
        <div class="nav-brand">
            <h1>🏦 SecureBank</h1>
        </div>
        <ul class="nav-links">
            <li><a href="/dashboard">Dashboard</a></li>
            <li><a href="/accounts">Accounts</a></li>
            <li><a href="/transfer">Transfer</a></li>
            <li><a href="/transactions">Transactions</a></li>
            <li><a href="/cards">Cards</a></li>
            <li><a href="/loans">Loans</a></li>
            <% if (role === 'admin') { %>
                <li><a href="/admin" class="admin-link">Admin</a></li>
            <% } %>
            <li><a href="/profile">Profile</a></li>
            <li><a href="/logout" class="logout">Logout</a></li>
        </ul>
    </nav>

    <div class="dashboard">
        <div class="welcome-section">
            <h2>Welcome back, <%= userName %>!</h2>
            <p>Here's an overview of your finances</p>
        </div>

        <div class="dashboard-grid">
            <div class="card balance-card">
                <h3>Total Balance</h3>
                <div class="balance-amount">$<%= totalBalance.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></div>
                <p class="balance-subtitle">Across all accounts</p>
            </div>

            <div class="card quick-actions">
                <h3>Quick Actions</h3>
                <div class="action-buttons">
                    <a href="/transfer" class="btn btn-primary">Transfer Money</a>
                    <a href="/accounts" class="btn btn-secondary">View Accounts</a>
                    <a href="/transactions" class="btn btn-secondary">Transactions</a>
                    <a href="/cards" class="btn btn-secondary">Manage Cards</a>
                </div>
            </div>
        </div>

        <div class="accounts-section">
            <h3>Your Accounts</h3>
            <div class="accounts-grid">
                <% accounts.forEach(account => { %>
                    <div class="account-card">
                        <div class="account-header">
                            <span class="account-type"><%= account.type.toUpperCase() %></span>
                            <span class="account-status status-<%= account.status %>"><%= account.status %></span>
                        </div>
                        <div class="account-number">****<%= account.accountNumber.slice(-4) %></div>
                        <div class="account-balance">$<%= account.balance.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></div>
                        <a href="/accounts/<%= account.id %>" class="btn btn-small">View Details</a>
                    </div>
                <% }) %>
            </div>
        </div>

        <div class="transactions-section">
            <h3>Recent Transactions</h3>
            <div class="transactions-table-container">
                <table class="transactions-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Description</th>
                            <th>Type</th>
                            <th>Amount</th>
                            <th>Balance</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (recentTransactions.length === 0) { %>
                            <tr>
                                <td colspan="5" class="no-data">No recent transactions</td>
                            </tr>
                        <% } else { %>
                            <% recentTransactions.forEach(transaction => { %>
                                <tr>
                                    <td><%= new Date(transaction.timestamp).toLocaleDateString() %></td>
                                    <td><%= transaction.description %></td>
                                    <td>
                                        <span class="transaction-type type-<%= transaction.type %>">
                                            <%= transaction.type.toUpperCase() %>
                                        </span>
                                    </td>
                                    <td class="<%= transaction.type %>">
                                        <%= transaction.type === 'credit' ? '+' : '-' %>$<%= transaction.amount.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %>
                                    </td>
                                    <td>$<%= transaction.balance.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
            <a href="/transactions" class="view-all">View All Transactions →</a>
        </div>
    </div>

    <footer>
        <p>&copy; 2024 SecureBank. All rights reserved.</p>
    </footer>
</body>
</html>
