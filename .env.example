# Database Configuration
DB_USERNAME=postgres
DB_PASSWORD=password

# RabbitMQ Configuration
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Configuration
JWT_SECRET=mySecretKeyForBankingApplicationThatShouldBeLongAndSecureAndRandomlyGeneratedForProductionUse
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=2592000000

# Encryption Key (32 bytes for AES-256)
ENCRYPTION_KEY=mySuperSecretEncryptionKey1234567890123456789012345678901234567890

# Email Configuration
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=your-email@gmail.com
EMAIL_SMTP_PASSWORD=your-app-password

# Security Configuration
SECURITY_USER_NAME=admin
SECURITY_USER_PASSWORD=admin123

# External Service URLs
EUREKA_SERVER_URL=http://localhost:8761/eureka
CONFIG_SERVER_URL=http://localhost:8888
API_GATEWAY_URL=http://localhost:8080

# Monitoring
PROMETHEUS_ENABLED=true
GRAFANA_URL=http://localhost:3000

# Logging
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_COM_BANK=DEBUG
